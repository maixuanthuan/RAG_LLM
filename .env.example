APP_ENV=dev
LOG_LEVEL=INFO

# LLM server (API chuẩn OpenAI).
# Ollama (dev):   http://localhost:11434/v1
# vLLM (server):  http://<ip-server>:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=120
# SYSTEM_PROMPT=...   (để trống = dùng lời dặn mặc định trong core/config.py)

# Server (make server-up): cổng web. 127.0.0.1 = chỉ máy server mở được (vào từ máy khác bằng
# SSH tunnel); 0.0.0.0 = mở cho cả mạng nội bộ (web chưa có đăng nhập, cân nhắc)
API_BIND=127.0.0.1
API_PORT=8080

# Chỉ dùng khi chạy api trong docker compose, trỏ ra LLM server trên máy host
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1

# ---- Phase 2: lưu trữ, embedding, truy xuất (có giá trị mặc định, chỉ sửa khi cần) ----
SQLITE_PATH=data/assistant.db
# Để trống = Qdrant chạy nhúng trong thư mục QDRANT_PATH. Dùng server: http://localhost:6333
QDRANT_URL=
QDRANT_PATH=data/qdrant
EMBED_MODEL=bge-m3
# Để trống = dùng chung LLM_BASE_URL. Model kiểu E5 cần EMBED_QUERY_PREFIX="query: " ...
EMBED_BASE_URL=
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ---- Phase 3: chat + RAG (có giá trị mặc định) ----
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=50
# Tài liệu ghim (/focus) ngắn hơn mức này thì đưa nguyên văn cho LLM; dài hơn thì tìm đoạn liên quan.
# Khoảng 12000 ký tự tiếng Việt vừa context 8192 token (xem OLLAMA_CONTEXT_LENGTH).
FOCUS_MAX_CHARS=12000
HISTORY_MAX_MESSAGES=8
GROUNDED_TEMPERATURE=0.1
# Ngưỡng độ giống tối thiểu khi tự tìm trong thư viện (xem "độ giống" trong ⓘ chi tiết để chỉnh)
MIN_RELEVANCE=0.5
TIMEZONE=Asia/Ho_Chi_Minh

# ---- Tài liệu dài: AI đọc trước toàn bộ theo từng phần (chạy nền sau khi nạp) ----
DIGEST_ENABLED=true
DIGEST_PART_CHARS=6000      # mỗi lần AI đọc ~6000 ký tự nguyên văn (vừa context 8192)
NEIGHBOR_CHUNKS=1           # câu hỏi cụ thể: lấy thêm 1 đoạn trước/sau đoạn tìm được

# ---- Tin tức (khu Tin tức, tách riêng khỏi chat tài liệu) ----
NEWS_ENABLED=true
NEWS_INTERVAL_MIN=30        # bao lâu lấy tin một lần
NEWS_KEEP_DAYS=7            # giữ tin bao nhiêu ngày
NEWS_MAX_PER_FEED=15
NEWS_REQUEST_DELAY_S=1.0    # nghỉ giữa các request tới báo
# Đổi danh sách chuyên mục / RSS (JSON một dòng). Mặc định: 10 chuyên mục từ VnExpress, Tuổi Trẻ,
# Thanh Niên, Dân trí, Báo Chính phủ (xem core/config.py). Thử link mới: make news-check URL=...
# NEWS_FEEDS={"thoi-su": {"label": "Thời sự", "urls": ["https://vnexpress.net/rss/thoi-su.rss"]}}
# Chuyên mục theo từ khoá (so có dấu): bài nào có từ khoá trong tiêu đề/sapo thì được gắn thêm
# NEWS_TOPICS={"thoi-tiet": {"label": "Thời tiết", "keywords": ["bão", "mưa lớn"]}}
NEWS_EVENT_THRESHOLD=0.82   # độ giống tiêu đề+sapo để gộp bài các báo thành một sự kiện

# ---- Thời tiết (Open-Meteo, miễn phí, không cần key) ----
WEATHER_ENABLED=true
WEATHER_LOCATION=Hà Nội
WEATHER_LAT=21.0285
WEATHER_LON=105.8542
