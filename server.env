# Cấu hình RIÊNG cho server (docker-compose.server.yml), ghi đè .env. Không ghi chú cuối dòng.
# Các dịch vụ gọi nhau bằng tên trong Docker
LLM_BASE_URL=http://ollama:11434/v1
EMBED_BASE_URL=http://ollama:11434/v1
QDRANT_URL=http://qdrant:6333

# Model: tự tải lần đầu bật. Server GPU nên embedding dùng bge-m3 gốc (chạy GPU)
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3
